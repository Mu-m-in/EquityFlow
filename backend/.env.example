# Local development values; Render supplies PORT and NODE_ENV=production.
NODE_ENV=development
PORT=3002
MONGO_URL=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/tradehub?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1h
PAPER_STARTING_CASH=100000
SESSION_COOKIE_MAX_AGE_MS=3600000
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5174
ALPHA_VANTAGE_API_KEY=
# Comma-separated official BSE/NSE full-day holidays (YYYY-MM-DD); update annually.
INDIA_MARKET_HOLIDAYS=
